<div class="control-group">
  <label class="control-label" for="website-url-input">{{i18n "admin.groups.website_url.label"}}</label>
  {{input id="website-url-input" class="input-xxlarge" type="text" value=(mut this.group.custom_fields.website_url) placeholder="Partner Website URL"}}
</div>

<div class="control-group">
  <label class="control-label" for="email-input">{{i18n "admin.groups.contact_email.label"}}</label>
  {{input id="email-input" class="input-xxlarge" type="email" value=(mut this.group.custom_fields.contact_email) placeholder="Contact Email"}}
</div>

<div class="control-group">
  <label class="control-label" for="facebook-url-input">{{i18n "admin.groups.facebook_url.label"}}</label>
  {{input id="facebook-url-input" class="input-xxlarge" type="text" value=(mut this.group.custom_fields.facebook_url) placeholder=(i18n "admin.groups.facebook_url.placeholder")}}
</div>

<div class="control-group">
  <label class="control-label" for="linkedin-url-input">{{i18n "admin.groups.linkedin_url.label"}}</label>
  {{input id="linkedin-url-input" class="input-xxlarge" type="text" value=(mut this.group.custom_fields.linkedin_url) placeholder="LinkedIn URL"}}
</div>

<div class="control-group">
  <label class="control-label" for="twitter-url-input">{{i18n "admin.groups.twitter_url.label"}}</label>
  {{input id="twitter-url-input" class="input-xxlarge" type="text" value=(mut this.group.custom_fields.twitter_url) placeholder="Twitter/X URL"}}
</div>

<div class="control-group">
  <label class="control-label" for="instagram-url-input">{{i18n "admin.groups.instagram_url.label"}}</label>
  {{input id="instagram-url-input" class="input-xxlarge" type="text" value=(mut this.group.custom_fields.instagram_url) placeholder="Instagram URL"}}
</div>

<div class="control-group">
  <label class="control-label" for="youtube-url-input">{{i18n "admin.groups.youtube_url.label"}}</label>
  {{input id="youtube-url-input" class="input-xxlarge" type="text" value=(mut this.group.custom_fields.youtube_url) placeholder="YouTube URL"}}
</div>